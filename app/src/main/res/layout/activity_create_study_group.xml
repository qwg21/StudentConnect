<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Toolbar Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-bold"
                android:text="New study group"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Group Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SC.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Group Name (e.g. CMT 314 Exam Squad)"
                    app:counterEnabled="true"
                    app:counterMaxLength="40">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_group_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="40"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Course Code AutoComplete Dropdown Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Course Code (e.g. CMT 314)"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:startIconDrawable="@drawable/ic_book"
                    app:startIconTint="@color/brand_primary">

                    <AutoCompleteTextView
                        android:id="@+id/actv_course_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SC.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Description / Study Goals"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_group_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:maxLength="200"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Max Members Stepper -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Max Members"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Limit: 2 to 20 members"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btn_minus_max"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:contentDescription="Decrease members"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="@color/brand_primary" />

                            <TextView
                                android:id="@+id/tv_max_members_count"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:text="8"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btn_plus_max"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_status_badge"
                                android:contentDescription="Increase members"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mode Two-Option Segmented Control -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Meeting Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_mode_segment"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:padding="2dp"
                        app:checkedButton="@id/btn_mode_online"
                        app:cornerRadius="24dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btn_mode_online"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="@color/selector_tab_bg"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Online"
                            android:textAllCaps="false"
                            android:textColor="@color/selector_tab_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            app:strokeWidth="0dp" />

                        <Button
                            android:id="@+id/btn_mode_in_person"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="@color/selector_tab_bg"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="In person"
                            android:textAllCaps="false"
                            android:textColor="@color/selector_tab_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            app:strokeWidth="0dp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </com.google.android.material.card.MaterialCardView>

                <!-- Location / Link Input (Dynamic Hint) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_location"
                    style="@style/Widget.SC.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Meeting Link / URL (e.g. Google Meet link)"
                    app:startIconDrawable="@drawable/ic_discover"
                    app:startIconTint="@color/brand_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri|textMultiLine"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Schedule Input -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SC.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Schedule (e.g. Tue &amp; Thu at 6 PM)"
                    app:startIconDrawable="@drawable/ic_clock"
                    app:startIconTint="@color/brand_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Progress Indicator & Create Button -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_create_group"
                    style="@style/Widget.SC.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Create Group" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</RelativeLayout>