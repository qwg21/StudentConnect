<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.StudentConnect" parent="Theme.Material3.Light.NoActionBar">
        <!-- Palette Roles -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_tint</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryContainer">@color/primary_tint</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- System Window Tints -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Widget Overrides -->
        <item name="textInputStyle">@style/Widget.SC.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.SC.Button.Primary</item>
    </style>

    <!-- Custom Text Input Style with Fully Rounded Pill / Curved Corners -->
    <style name="Widget.SC.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/text_input_hint</item>
        <item name="startIconTint">@color/brand_primary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <!-- Primary Pill Button Style -->
    <style name="Widget.SC.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Secondary Outlined Pill Button Style -->
    <style name="Widget.SC.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">100dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Soft Tonal Pill Button Style -->
    <style name="Widget.SC.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">100dp</item>
        <item name="backgroundTint">@color/primary_tint</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.SC.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Theme.StudentConnect" parent="Base.Theme.StudentConnect" />
</resources>